#!/usr/bin/env python3
"""Кроссплатформенная точка входа для «Гармонии».

Работает на Linux, macOS, Windows (через python), Android (Termux).
"""

import sys
from pathlib import Path

# Добавляем корень проекта в sys.path
_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from eaca.cli import main

if __name__ == "__main__":
    sys.exit(main())
